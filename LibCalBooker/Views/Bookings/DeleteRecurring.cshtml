@model LibCalBooker.Models.RecurringBooking
@{
    ViewData["Title"] = "Delete Recurring Booking";
}
<h1>Delete Recurring Booking</h1>
<h3>Are you sure you want to delete this recurring booking?</h3>
<div>
    <h4>Recurring Booking</h4>
    <hr />
    <dl class="row">
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.Name)
        </dd>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StartDate)
        </dd>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EndDate)
        </dd>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BookingTime)
        </dd>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Interval)
        </dd>
    </dl>
    <form asp-action="DeleteRecurring">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>