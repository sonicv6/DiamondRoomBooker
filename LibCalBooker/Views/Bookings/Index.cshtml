@model IEnumerable<LibCalBooker.Models.Booking>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New Booking</a>
</p>
<p></p>
    <a asp-action="CreateRecurring">Create New Recurring Booking</a>
</p>
<h2>Bookings</h2>
<div id="bookings"></div>
<script>
fetch('/Bookings/Bookings')
  .then(response => response.text())
  .then(html => {
    document.getElementById('bookings').innerHTML = html;
  });
</script>
<h2>Recurring Bookings</h2>
<div id="recurring-bookings"></div>
<script>
fetch('/Bookings/RecurringBookings')
  .then(response => response.text())
  .then(html => {
    document.getElementById('recurring-bookings').innerHTML = html;
  });
</script>